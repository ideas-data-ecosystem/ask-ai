# Copy to .env and fill in. Placeholders only; .env is git-ignored.
# Keep passwords URL/shell-safe (letters, digits, - and _).

# Postgres owner role (superuser in the pgvector image): used for migrations only. In compose only the db and the
# one-shot migrate service get POSTGRES_PASSWORD; api and worker do not (they connect as rag_app).
POSTGRES_DB=chatai
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-owner
# Password of the unprivileged rag_app role the app connects as (set by the first migration).
# Only applied when the role is first created; rotating it later needs ALTER ROLE rag_app PASSWORD ... as the owner.
RAG_APP_PASSWORD=change-me-app

# Host port for the API (bound to 127.0.0.1).
API_PORT=8000

# Vector dimension of the embedding model. Fixed when the DB is first migrated:
# changing it later needs a new migration or a fresh DB volume.
EMBEDDING_DIM=1024

# Embeddings: OpenAI-compatible /embeddings endpoint (base URL without the trailing /embeddings).
# EMBEDDING_DIM above must equal the model's output size (NVIDIA Nemotron embed: 2048).
# Fallback to another model should be turned off for this route in the router; the app also refuses vectors
# whose canary drifts (see docs), and a KB indexed with another embedding setup (EMBEDDING_MODEL, the prefixes or
# the extra bodies below) answers "reindex required".
EMBEDDING_BASE_URL=https://your-router.example/v1
EMBEDDING_API_KEY=change-me
EMBEDDING_MODEL=your-embedding-model
# Texts per request (one more slot carries the canary sentence).
EMBEDDING_BATCH=16
# Asymmetric models need to know documents from questions. Text prefixes (e5, qwen3, ...); quote to keep the space:
#EMBEDDING_DOC_PREFIX="passage: "
#EMBEDDING_QUERY_PREFIX="query: "
# JSON merged into the request body per mode. NVIDIA Nemotron; "truncate" avoids errors on long chunks:
#EMBEDDING_DOC_EXTRA_BODY={"input_type":"passage","truncate":"END"}
#EMBEDDING_QUERY_EXTRA_BODY={"input_type":"query","truncate":"END"}

# LLM: LLM_PROTOCOL is openai (Chat Completions) or anthropic (Messages).
LLM_PROTOCOL=openai
LLM_BASE_URL=https://your-router.example/v1
LLM_API_KEY=change-me
LLM_MODEL=your-llm-model
# Reasoning models spend completion tokens before they answer; a reply cut at this limit is an error (HTTP 502).
LLM_MAX_TOKENS=2048
# JSON passed as extra_body to the SDK, for per-model knobs (effort, temperature, ...). Empty counts as unset.
# openai: base URL ends in /v1. anthropic: the SDK adds /v1/messages itself, so leave /v1 off.
# NVIDIA Nemotron with low-effort reasoning:
#LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":true,"low_effort":true}}
# Follow-up questions (a question sent with earlier turns) are first rewritten into a standalone question by one more
# call with this JSON merged over LLM_EXTRA_BODY (top-level keys replace). The rewrite needs no reasoning, so turn it
# off here for a reasoning model; empty means the same body as answers. The call is capped at 256 tokens and falls
# back to the question alone when it fails. NVIDIA Nemotron:
#LLM_REWRITE_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false},"temperature":0}

# Optional rerank endpoint (OpenAI-style /rerank). Leave RERANK_MODEL unset to keep the fused order.
#RERANK_BASE_URL=
#RERANK_API_KEY=
#RERANK_MODEL=

# Retrieval and limits. FUSION_VECTOR_WEIGHT weighs the normalised vector score against the normalised lexical score
# (0..1); it is tied to the embedding model. MIN_SIMILARITY is the evidence gate (cosine similarity of the best returned
# chunk). Tune both with `python -m eval.run_eval` (see README).
TOP_K=8
FUSION_VECTOR_WEIGHT=0.7
MIN_SIMILARITY=0.15
MAX_QUESTION_CHARS=1000
MAX_UPLOAD_MB=50
# Per-document ingestion caps, so one hostile or huge file cannot tie the worker up: a PDF over MAX_PDF_PAGES pages,
# or needing OCR on more than MAX_OCR_PAGES pages, fails its job with a clear message.
MAX_PDF_PAGES=1000
MAX_OCR_PAGES=300

# The session cookie is Secure unless this is false (the app's default is true); leave it unset behind TLS.
# Local plain-http development (a browser does not send a Secure cookie over http, so login would not stick):
# uncomment this line and set it to false.
#COOKIE_SECURE=false

# Host runs only (uv run ...): point at the repo's corpus and the published db port.
# In compose these are overridden (STORAGE_DIR=/data/knowledges, DB_HOST=db).
#STORAGE_DIR=../knowledges
#STATIC_DIR=../frontend/dist
#DB_HOST=127.0.0.1
#DB_PORT=5433
